VITE_SUPABASE_URL=your-supabase-url-here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: override the Leaflet basemap tiles (defaults to keyless OpenStreetMap).
# VITE_MAP_TILE_URL=
# VITE_MAP_TILE_ATTRIBUTION=

# reCAPTCHA v3 site key for the resume-submission form (public).
# The matching secret is set on the edge function: supabase secrets set RECAPTCHA_SECRET_KEY=...
VITE_RECAPTCHA_SITE_KEY=
