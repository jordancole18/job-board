VITE_SUPABASE_URL=your-supabase-url-here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: override the Leaflet basemap tiles (defaults to keyless OpenStreetMap).
# VITE_MAP_TILE_URL=
# VITE_MAP_TILE_ATTRIBUTION=

# Cloudflare Turnstile site key for the resume-submission CAPTCHA (public).
# The matching secret is set on the edge function: supabase secrets set TURNSTILE_SECRET_KEY=...
VITE_TURNSTILE_SITE_KEY=
